# ---------------------------------------------------------------------------
# Copiar este archivo a .env y ajustar los valores:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Aplicacion -----------------------------------------------------------
LOG_LEVEL=INFO
APP_TIMEZONE=America/La_Paz
DEFAULT_CURRENCY=BOB

# --- Base de datos --------------------------------------------------------
# Dentro de Docker Compose el host de PostgreSQL es el servicio "db".
POSTGRES_USER=gastos
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=gastos
DATABASE_URL=postgresql+asyncpg://gastos:change-me-postgres-password@db:5432/gastos

# --- Integracion n8n / Telegram -------------------------------------------
# API Key que n8n debe enviar en la cabecera X-API-Key.
N8N_API_KEY=change-me-n8n-api-key

# --- CORS (solo necesario en desarrollo con Vite en otro puerto) ---------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Puertos publicados en el host ---------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080
